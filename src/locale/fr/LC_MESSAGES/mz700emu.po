msgstr ""
"Synchronisation verticale GDG - début d'une nouvelle trame (ligne raster 0)."

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:256
#, c-format
msgid ""
"GDG raster line - parametrized N (0..%u); trigger at start of given scanline."
msgstr ""
"Ligne raster GDG - N paramétré (0..%u); déclenche au début de la scanline "
"donnée."

