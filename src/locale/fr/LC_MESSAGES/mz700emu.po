#: src/ui-imgui/debugger/ioview/io_window.cpp:1850
msgid ""
"Filter syntax (boolean expression):\n"
"Atoms (leaf tokens):\n"
"  port:CE       low byte match (8-bit IORQ, ignores random B reg)\n"
"  port:C0-CF    low byte range\n"
"  port16:00CE   full 16-bit match (explicit BC pattern)\n"
"  port16:CF00-CF0F  16-bit range\n"
"  pc:4042 / pc:4000-40FF          PC match / range\n"
"  value:42 / value:00-7F          value match / range\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      MMIO address match / range\n"
"  in / out      IORQ direction\n"
"  mr / mw       MMIO direction\n"
"  text          name substring (case-insensitive)\n"
"Operators (high to low precedence):\n"
"  ( )           grouping\n"
"  !             NOT (over leaf or parenthesized expression)\n"
"  space & AND   AND (AND keyword is uppercase only)\n"
"  | OR          OR  (OR keyword is uppercase only)\n"
"Examples:\n"
"  port:CE pc:4042            both must match\n"
"  port:CE | port:CF          either port\n"
"  (port:CE pc:42) | port:CF  group OR group\n"
"  !(in | out)                neither IN nor OUT"
msgstr ""
"Syntaxe filtre (expression booléenne) :\n"
"Atomes (tokens feuilles) :\n"
"  port:CE       match octet bas (IORQ 8-bit, ignore le registre B "
"aléatoire)\n"
"  port:C0-CF    plage octet bas\n"
"  port16:00CE   match 16-bit complet (motif BC explicite)\n"
"  port16:CF00-CF0F  plage 16-bit\n"
"  pc:4042 / pc:4000-40FF          match / plage PC\n"
"  value:42 / value:00-7F          match / plage de valeur\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      match / plage d'adresse MMIO\n"
"  in / out      direction IORQ\n"
"  mr / mw       direction MMIO\n"
"  text          sous-chaîne de nom (insensible à la casse)\n"
"Opérateurs (priorité haute à basse) :\n"
"  ( )           groupement\n"
"  !             NOT (sur feuille ou expression parenthésée)\n"
"  espace & AND  AND (mot-clé AND en majuscules uniquement)\n"
"  | OR          OR  (mot-clé OR en majuscules uniquement)\n"
"Exemples :\n"
"  port:CE pc:4042            les deux doivent matcher\n"
"  port:CE | port:CF          l'un ou l'autre port\n"
"  (port:CE pc:42) | port:CF  groupe OR groupe\n"
"  !(in | out)                ni IN ni OUT"

