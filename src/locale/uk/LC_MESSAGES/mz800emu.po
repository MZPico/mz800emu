msgid "Edit Group"
msgstr "Редагувати групу"

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2737
msgid "New Group"
msgstr "Нова група"

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2791
msgid "Edit BP"
msgstr "Редагувати BP"

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2796
