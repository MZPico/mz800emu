msgstr "Запустити при N-тому проходу (0 = кожен звернення)."

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2349
msgid "Skip count:"
msgstr "Кількість пропуску:"

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2360
msgid "Ignore first N passes, then start counting hit count."
msgstr "Ignorovat перших N проходів, тоді почати рахувати кількість звернень."

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2401
msgid ""
"Reaction AFTER the trigger:\n"
"  Stop = classic BP, halts the emulator\n"
"  Log only = TTY output + continue (log \"BP X\"; continue)\n"
"  Custom = full mini-DSL script\n"
"Reference: docs/cz/debugger/breakpoints/action-dsl.md"
msgstr ""
"Reakce Після запуску:\n"
"  Stop = класичний BP, зупинить емулятор\n"
"  Log only = TTY вихід + продовжити (log \"BP X\"; continue)\n"
"  Custom = повний mini-DSL skript\n"
"Reference: docs/cz/debugger/breakpoints/action-dsl.md"

#: src/ui-imgui/debugger/breakpoints/bpt_edit_panel.cpp:2432
msgid "(action empty - BP halts the emulator)"
msgstr "(дія порожня - BP зупинить емулятор)"

