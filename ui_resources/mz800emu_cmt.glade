          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="cmt_tape_liststore">
    <columns>
      <!-- column-name file_position -->
      <column type="guint"/>
      <!-- column-name fname -->
      <column type="gchararray"/>
      <!-- column-name ftype -->
      <column type="gchararray"/>
      <!-- column-name fsize -->
      <column type="gchararray"/>
      <!-- column-name fstrt -->
      <column type="gchararray"/>
      <!-- column-name fexec -->
      <column type="gchararray"/>
      <!-- column-name block_type -->
      <column type="guint"/>
      <!-- column-name block_speed -->
      <column type="guint"/>
      <!-- column-name play_icon_pixbuf -->
      <column type="GdkPixbuf"/>
      <!-- column-name play_icon_visible -->
      <column type="gboolean"/>
      <!-- column-name cmtspeed -->
      <column type="guint"/>
      <!-- column-name cmtspeed_txt -->
      <column type="gchararray"/>
      <!-- column-name cmtspeed_sensitive -->
      <column type="gboolean"/>
      <!-- column-name cmtspeed_mz_visible -->
      <column type="gboolean"/>
      <!-- column-name cmtspeed_zx_visible -->
      <column type="gboolean"/>
      <!-- column-name cmtspeed_pencil_visible -->
      <column type="gboolean"/>
      <!-- column-name length_txt -->
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkWindow" id="cmt_tape_window">
    <property name="height_request">250</property>
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Tape Filelist</property>
    <property name="transient_for">cmt_window</property>
    <signal name="key-press-event" handler="on_cmt_tape_window_key_press_event" swapped="no"/>
    <signal name="delete-event" handler="on_cmt_tape_window_delete_event" swapped="no"/>
    <child>
      <object class="GtkScrolledWindow" id="cmt_tape_scrolledwindow">
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="hscrollbar_policy">never</property>
        <property name="shadow_type">in</property>
        <child>
          <object class="GtkTreeView" id="cmt_tape_treeview">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="margin_top">5</property>
            <property name="model">cmt_tape_liststore</property>
            <property name="headers_clickable">False</property>
            <property name="rules_hint">True</property>
            <property name="enable_search">False</property>
            <property name="hover_selection">True</property>
            <property name="enable_grid_lines">vertical</property>
            <signal name="button-press-event" handler="on_cmt_tape_treeview_button_press_event" swapped="no"/>
            <signal name="row-activated" handler="on_cmt_tape_treeview_row_activated" swapped="no"/>
            <child internal-child="selection">
              <object class="GtkTreeSelection" id="treeview-selection1"/>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn1">
                <property name="title" translatable="yes">#</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext1"/>
                  <attributes>
                    <attribute name="text">0</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="cmt_tape_play_icon_treeviewcolumn">
                <child>
                  <object class="GtkCellRendererPixbuf" id="cellrendererpixbuf1"/>
                  <attributes>
                    <attribute name="visible">9</attribute>
                    <attribute name="pixbuf">8</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn2">
                <property name="title" translatable="yes">Name</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext2"/>
                  <attributes>
                    <attribute name="text">1</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn3">
                <property name="title" translatable="yes">Type</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext3"/>
                  <attributes>
                    <attribute name="text">2</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn4">
                <property name="title" translatable="yes">Size</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext4"/>
                  <attributes>
                    <attribute name="text">3</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn5">
                <property name="title" translatable="yes">Start</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext5"/>
                  <attributes>
                    <attribute name="text">4</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn6">
                <property name="title" translatable="yes">Exec</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext6"/>
                  <attributes>
                    <attribute name="text">5</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="cmt_tape_speed_treeviewcolumn">
                <property name="title" translatable="yes">Speed</property>
                <child>
                  <object class="GtkCellRendererPixbuf" id="cmt_index_speed_cellrendererpixbuf">
                    <property name="icon_name">gtk-edit</property>
                  </object>
                  <attributes>
                    <attribute name="sensitive">12</attribute>
                    <attribute name="visible">15</attribute>
                  </attributes>
                </child>
                <child>
                  <object class="GtkCellRendererCombo" id="cmtspeed_mz_cellrenderercombo">
                    <property name="editable">True</property>
                    <property name="has_entry">False</property>
                    <property name="model">cmtspeed_mz_combo_liststore</property>
                    <property name="text_column">1</property>
                    <signal name="changed" handler="on_cmtspeed_mz_cellrenderercombo_changed" swapped="no"/>
                  </object>
                  <attributes>
                    <attribute name="sensitive">12</attribute>
                    <attribute name="visible">13</attribute>
                    <attribute name="text">11</attribute>
                  </attributes>
                </child>
                <child>
                  <object class="GtkCellRendererCombo" id="cmtspeed_zx_cellrenderercombo">
                    <property name="editable">True</property>
                    <property name="has_entry">False</property>
                    <property name="model">cmtspeed_zx_combo_liststore</property>
                    <property name="text_column">1</property>
                    <signal name="changed" handler="on_cmtspeed_zx_cellrenderercombo_changed" swapped="no"/>
                  </object>
                  <attributes>
                    <attribute name="sensitive">12</attribute>
                    <attribute name="visible">14</attribute>
                    <attribute name="text">11</attribute>
                  </attributes>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTreeViewColumn" id="treeviewcolumn8">
                <property name="title" translatable="yes">Length</property>
                <child>
                  <object class="GtkCellRendererText" id="cellrenderertext7"/>
                  <attributes>
                    <attribute name="text">16</attribute>
                  </attributes>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="cmt_window">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Virtual CMT</property>
    <property name="resizable">False</property>
    <property name="icon_name">media-tape</property>
    <property name="type_hint">utility</property>
    <signal name="key-press-event" handler="on_cmt_window_key_press_event" swapped="no"/>
    <signal name="delete-event" handler="on_cmt_window_delete_event" swapped="no"/>
    <child>
      <object class="GtkVBox" id="vbox5_up">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <child>
          <object class="GtkVBox" id="vbox_cmt_ready">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <child>
              <object class="GtkVBox" id="cmt_display_vbox">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <child>
                  <object class="GtkBox" id="box4">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="margin_left">10</property>
                    <property name="margin_right">10</property>
                    <child>
                      <object class="GtkEventBox" id="cmt_time_info_eventbox">
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <signal name="button-press-event" handler="on_cmt_time_info_eventbox_button_press_event" swapped="no"/>
                        <child>
                          <object class="GtkLabel" id="cmt_time_info_label">
                            <property name="visible">True</property>
                            <property name="can_focus">False</property>
                            <property name="has_tooltip">True</property>
                            <property name="tooltip_markup" translatable="yes">click here :-)</property>
                            <property name="tooltip_text" translatable="yes">click here :-)</property>
                            <property name="halign">start</property>
                            <property name="xalign">0.10000000149011612</property>
                            <property name="label" translatable="yes">Remaining time:</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkFixed" id="fixed3">
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="cmt_cpu_boost_checkbutton">
                        <property name="label" translatable="yes">CPU boost</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="receives_default">False</property>
                        <property name="has_tooltip">True</property>
                        <property name="tooltip_markup" translatable="yes">Boost CPU speed to MAX, when CMT is playing</property>
                        <property name="tooltip_text" translatable="yes">Boost CPU speed to MAX, when CMT is playing</property>
                        <property name="xalign">0</property>
                        <property name="draw_indicator">True</property>
                        <signal name="toggled" handler="on_cmt_cpu_boost_checkbutton_toggled" swapped="no"/>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">2</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEventBox" id="cmt_time_eventbox">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <signal name="button-press-event" handler="on_cmt_time_eventbox_button_press_event" swapped="no"/>
                    <child>
                      <object class="GtkLabel" id="cmt_time_label">
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="tooltip_text" translatable="yes">click here :-)</property>
                        <property name="label" translatable="yes">&lt;b&gt;&lt;span font='50'&gt;00:00&lt;/span&gt;&lt;/b&gt;
</property>
                        <property name="use_markup">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkHSeparator" id="hseparator4">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="padding">10</property>
                    <property name="position">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="box2">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="margin_left">10</property>
                    <property name="margin_right">10</property>
                    <child>
                      <object class="GtkBox" id="box3">
                        <property name="visible">True</property>
