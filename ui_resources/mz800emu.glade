                    <property name="title" translatable="yes">Select All-In-One ROM Binary File</property>
                    <signal name="file-set" handler="on_filechooserbutton_rom_allinone_file_set" swapped="no"/>
                  </object>
                  <packing>
                    <property name="left_attach">1</property>
                    <property name="top_attach">3</property>
                    <property name="width">1</property>
                    <property name="height">1</property>
                  </packing>
                </child>
