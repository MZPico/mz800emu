# Python runtime artefakty - venv, bytecode, logy. Žádný z těchto
# souborů nesmí jít do commitu.
.venv/
__pycache__/
*.pyc
*.pyo

# Server log soubor (= MCP wire stdio bezpečnostní logging).
mcp_server.log

# Generated by mcpinit.sh - obsahuje absolutní cesty pro konkrétní
